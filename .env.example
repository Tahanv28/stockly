# Copy to .env.local for local development.

# Postgres connection string (local Postgres, Supabase, Neon, ...)
DATABASE_URL=postgres://postgres@localhost:5432/stockly

# Public URL of the app, used in QR labels and invite links
APP_URL=http://localhost:3000

# Photo storage. If S3_BUCKET is empty, photos are stored on local disk in
# ./.data/uploads (fine for development, NOT for serverless hosting).
# Any S3-compatible storage works: Supabase Storage (S3 API), Cloudflare R2, AWS S3.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Secret for the daily maintenance job (/api/cron/daily). Vercel Cron sends it automatically.
CRON_SECRET=
